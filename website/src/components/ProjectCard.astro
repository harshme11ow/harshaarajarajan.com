---
const { project, compact = false } = Astro.props;
---
<a class:list={["project-card", compact && "project-card--compact"]} href={`/projects/${project.slug}`}>
  <div class={`project-art art-${project.number}`} aria-hidden="true">
    <div class="art-grid"></div>
    <span class="art-index">ARCHIVE / {project.number}</span>
    {project.number === '01' ? (
      <svg viewBox="0 0 380 240" fill="none"><path d="M36 102 L150 120 L150 186 L36 168 Z M230 116 L352 88 L352 157 L230 189 Z" stroke="currentColor" stroke-width="2.4"/><path d="M157 104 L201 94 L232 118 L187 130 Z M157 104 L187 130 L187 185 L157 161 Z M187 130 L232 118 L232 174 L187 185 Z" stroke="currentColor" stroke-width="2.4"/><path d="M103 113 L157 135 M231 141 L295 125 M191 95 L195 66 M181 74 Q194 91 207 70" stroke="currentColor" stroke-width="2"/><circle cx="197" cy="57" r="3" fill="currentColor"/></svg>
    ) : project.number === '02' ? (
      <svg viewBox="0 0 380 240" fill="none"><path d="M40 159 L85 129 L150 120 L208 99 L295 108 L329 145 L330 166 L48 177 Z" stroke="currentColor" stroke-width="3"/><circle cx="116" cy="172" r="30" stroke="currentColor" stroke-width="3"/><circle cx="281" cy="163" r="30" stroke="currentColor" stroke-width="3"/><path d="M88 133 L218 122 L261 132 M167 117 L195 72 L275 75 L300 116" stroke="currentColor" stroke-width="2"/><rect x="174" y="149" width="53" height="29" rx="3" stroke="currentColor"/><path d="M184 160 H218 M184 167 H203" stroke="currentColor"/></svg>
    ) : project.number === '03' ? (
      <svg viewBox="0 0 380 240" fill="none"><rect x="79" y="44" width="224" height="154" rx="13" stroke="currentColor" stroke-width="3"/><rect x="100" y="63" width="182" height="101" rx="4" stroke="currentColor"/><path d="M108 131 H137 L152 108 L171 145 L196 86 L208 123 H273" stroke="currentColor" stroke-width="3"/><path d="M119 184 H260" stroke="currentColor" stroke-width="2"/><circle cx="285" cy="177" r="7" stroke="currentColor"/></svg>
    ) : (
      <svg viewBox="0 0 380 240" fill="none"><rect x="64" y="44" width="252" height="156" rx="5" stroke="currentColor" stroke-width="3"/><path d="M64 80 H316 M88 105 H202 M88 124 H277 M88 145 H230 M88 165 H254" stroke="currentColor" stroke-width="2"/><rect x="238" y="94" width="55" height="23" stroke="currentColor"/><path d="M251 105 L263 113 L279 97" stroke="currentColor" stroke-width="2"/></svg>
    )}
    <span class="art-category">{project.category}</span>
  </div>
  <div class="project-card-body">
    <div class="project-card-top"><span>{project.role}</span><span>{project.year}</span></div>
    <div class="project-card-title-row"><h3>{project.title}</h3><span class="card-arrow" aria-hidden="true">↗</span></div>
    <p>{project.subtitle}</p>
    <div class="chip-row">{project.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
  </div>
</a>
