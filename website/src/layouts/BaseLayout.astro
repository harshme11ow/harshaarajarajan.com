---
import SiteNav from '../components/SiteNav.jsx';
import { ClientRouter } from 'astro:transitions';
import { site } from '../data/site.js';
import '../styles/global.css';

const {
  title = "Harshaa's Originals",
  description = site.shortBio,
} = Astro.props;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#071925" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="site-frame">
      <SiteNav client:load currentPath={path} transition:persist />
      <slot />
      <footer class="global-footer wrap">
        <span><span class="footer-mark">H/R</span> &nbsp; HARSHAA'S ORIGINALS</span>
        <span>ENGINEERED WITH CURIOSITY <span class="footer-dot">●</span> <a href="/connect">LET'S CONNECT ↗</a></span>
      </footer>
    </div>
  </body>
</html>
