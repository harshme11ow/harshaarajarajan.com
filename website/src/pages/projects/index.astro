---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectArchiveReel from '../../components/ProjectArchiveReel.jsx';
import { projects } from '../../data/projects.js';
---
<BaseLayout title="Projects — Harshaa's Originals" description="Engineering project archive covering satellites, electric vehicles, embedded systems, and software.">
  <main class="wrap page-main">
    <section class="archive-header" aria-labelledby="archive-title">
      <div class="page-heading archive-intro enter">
        <span class="eyebrow">ARCHIVE / 001—004</span>
        <h1 id="archive-title">Project archive<span class="period">.</span></h1>
        <p>Selected technical work, prototypes, and experiments. The interesting part is often what happens between the first schematic and the final test.</p>
      </div>
      <div class="archive-reel-column enter enter-delay">
        <ProjectArchiveReel client:load />
      </div>
    </section>
    <div class="archive-meta"><span>INDEX / ALL PROJECTS</span><span>{projects.length} ENTRIES</span></div>
    <div class="project-grid project-grid--archive">
      {projects.map((project) => <ProjectCard project={project}/>)}
    </div>
    <aside class="small-aside">
      <span class="eyebrow">A NOTE ABOUT THE ARCHIVE</span>
      <p>Case studies are works in progress. Detailed data, diagrams, and test results will be added as projects mature and sharing permissions are confirmed.</p>
    </aside>
  </main>
</BaseLayout>
