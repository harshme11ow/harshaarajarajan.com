---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site.js';
---
<BaseLayout title="CV — Harshaa's Originals">
  <main class="wrap page-main"><div class="page-heading enter"><span class="eyebrow">CURRICULUM VITAE / 001</span><h1>Experience &amp;<br/>education<span class="period">.</span></h1><p>A snapshot of my technical work, teams, and areas of interest. I'm keeping this page readable and adding detailed evidence in individual project write-ups.</p>{site.resumePath ? <a class="button button-primary" href={site.resumePath} download>Download résumé ↗</a> : <span class="info-label">PDF résumé link can be enabled in <code>src/data/site.js</code></span>}</div>
    <div class="cv-grid"><div class="cv-col-label"><span class="eyebrow">01 / EDUCATION</span></div><div class="cv-row"><h2>University of Georgia</h2><span>Electrical &amp; Electronics Engineering</span><p>Coursework and team-based hardware projects spanning circuits, electronics, and embedded systems.</p></div>
    <div class="cv-col-label"><span class="eyebrow">02 / ENGINEERING EXPERIENCE</span></div><div class="cv-row"><div class="cv-entry"><div><h2>UGA Small Satellite Research Laboratory</h2><span>Hardware Engineer</span></div><small>Research team</small></div><p>Satellite electronics work on BoBa and related lab projects. See the project archive for public technical write-ups.</p><div class="cv-entry"><div><h2>UGA Motorsports — Formula EV</h2><span>Powertrain</span></div><small>Student design team</small></div><p>PCB work involving brake/acceleration encoding and electronic throttle control.</p></div>
    <div class="cv-col-label"><span class="eyebrow">03 / OTHER EXPERIENCE</span></div><div class="cv-row"><div class="cv-entry"><div><h2>Student leadership &amp; public speaking</h2><span>Kennesaw State University, Model UN, teaching</span></div></div><p>Experience organizing, communicating, mentoring, and working with teams outside technical settings.</p></div>
    <div class="cv-col-label"><span class="eyebrow">04 / TECHNICAL INTERESTS</span></div><div class="cv-row"><div class="chip-row chip-row--large">{["PCB design", "Embedded C", "Python", "Microcontrollers", "ESP32", "CAN", "I²C", "Sensors", "Validation", "Technical communication"].map((skill) => <span class="chip">{skill}</span>)}</div><p class="muted-text">This is a starter summary, not a complete verified résumé. Adjust exact responsibilities, software, dates, and proficiency before publishing.</p></div></div>
  </main>
</BaseLayout>
