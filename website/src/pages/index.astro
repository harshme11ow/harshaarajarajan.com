---
import BaseLayout from '../layouts/BaseLayout.astro';
import SatelliteScene from '../components/SatelliteScene.jsx';
import HomeBoot from '../components/HomeBoot.jsx';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects.js';
import { journal } from '../data/journal.js';
---
<BaseLayout title="Harshaa's Originals — Engineering, experiments & ideas">
  <HomeBoot client:load />
  <main>
    <section class="home-hero wrap">
      <div class="home-copy enter">
        <div class="eyebrow hero-eyebrow"><span class="online-dot"></span> PERSONAL ARCHIVE <span class="hairline"></span> V.01 / 2026</div>
        <h1>Making things.<br/><em>Figuring things out.</em></h1>
        <p class="hero-intro">I'm Harshaa—an electrical engineering student drawn to satellites, electric vehicles, embedded systems, and occasionally strange ideas that turn into projects.</p>
        <div class="hero-buttons"><a class="button button-primary" href="/projects">Explore the work <span>↗</span></a><a class="text-link" href="/about">A little about me <span>↗</span></a></div>
        <div class="hero-coda"><span>SCROLL TO EXPLORE</span><span class="down-arrow">↓</span></div>
      </div>
      <div class="home-visual enter enter-delay"><SatelliteScene client:load /></div>
    </section>
    <div class="divider-wrap wrap"><div class="rule"></div><span>01 / SELECTED WORK</span></div>
    <section class="home-projects wrap section-pad">
      <div class="section-head"><div><span class="eyebrow">AN OPEN WORKBENCH</span><h2>Some things I've built<span class="muted-heading"> / and am building.</span></h2></div><a class="text-link" href="/projects">All projects ↗</a></div>
      <div class="project-grid">{projects.slice(0, 3).map((project) => <ProjectCard project={project}/>)}</div>
    </section>
    <section class="home-about band"><div class="wrap home-about-grid"><div class="about-symbol" aria-hidden="true"><span>H</span><span class="slash">/</span><span>R</span><small>EST. 2026</small></div><div><span class="eyebrow">02 / THE PERSON BEHIND THE WORK</span><h2>Engineer by discipline.<br/><em>Curious by default.</em></h2><p>I like the point where a rough idea becomes something you can hold, test, debug, and improve. This site is where I plan to document the work—and a little of everything else.</p><a href="/about" class="text-link">More about me ↗</a></div></div></section>
    <section class="home-journal wrap section-pad"><div class="section-head"><div><span class="eyebrow">03 / FIELD NOTES</span><h2>Notes from the workbench.</h2></div><a class="text-link" href="/journal">Open journal ↗</a></div><div class="notes-grid">{journal.map((entry) => <a href={`/journal/${entry.slug}`} class="note-card"><span class="eyebrow">{entry.date} / {entry.category}</span><h3>{entry.title} <span>↗</span></h3><p>{entry.description}</p></a>)}</div><p class="hint">These journal entries currently contain sample writing.</p></section>
    <section class="originals-home-teaser wrap" aria-labelledby="originals-home-title">
      <div><span class="eyebrow">04 / OFF THE CLOCK</span><h2 id="originals-home-title">There's more to the <em>story.</em></h2><p>Vlogs, filmmaking, and the creative projects that happen outside the engineering lab.</p></div>
      <a href="/originals" class="button button-outline">Visit Harshaa's Originals <span>↗</span></a>
    </section>
    <section class="contact-band"><div class="wrap contact-band-inner"><div><span class="eyebrow">05 / OPEN CHANNEL</span><h2>Have an idea?<br/>Let's talk.</h2></div><a href="/connect" class="button button-primary">Get in touch <span>↗</span></a></div></section>
  </main>
</BaseLayout>
